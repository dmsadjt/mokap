---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang } from '../i18n/ui';
import { site } from '../config/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = site.name,
	description = `${site.name} — process design, engineering, procurement, construction and maintenance of industrial equipment and systems.`,
} = Astro.props;

const lang = Astro.currentLocale ?? defaultLang;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | {site.name}</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-red: #cc1b1b;
		--color-red-dark: #da1c1f;
		--color-navy: #203768;
		--color-text: #333333;
		--color-bg: #ffffff;
		--color-bg-alt: #f5f5f5;
		--font-sans:
			'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--container-width: 1180px;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
	}

	body {
		font-family: var(--font-sans);
		color: var(--color-text);
		background: var(--color-bg);
		line-height: 1.6;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: var(--font-sans);
		line-height: 1.25;
		margin: 0 0 0.5em;
	}

	p {
		margin: 0 0 1em;
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
		display: block;
	}

	.container {
		width: 100%;
		max-width: var(--container-width);
		margin: 0 auto;
		padding: 0 24px;
	}

	.label {
		display: inline-block;
		color: var(--color-red);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.85rem;
		margin-bottom: 0.75rem;
	}

	.btn {
		display: inline-block;
		background: var(--color-red);
		color: #fff;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		padding: 0.85em 2em;
		border: none;
		border-radius: 2px;
		cursor: pointer;
		font-size: 0.9rem;
		transition: background 0.2s ease;
	}

	.btn:hover {
		background: var(--color-red-dark);
	}

	section {
		padding: 64px 0;
	}
</style>
