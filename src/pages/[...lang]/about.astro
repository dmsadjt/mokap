---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Icon from "../../components/Icon.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

import { badLang } from "../../lib/lang";
if (badLang(Astro.params.lang)) return new Response(null, { status: 404 });
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);


---

<Layout title={t("about.title")}>
    <PageHeader title={t("about.title")} subtitle={t("about.subtitle")} />

    <section>
        <div class="container about-grid">
            <div>
                <span class="label">{t("about.overview.label")}</span>
                <h2>{t("about.overview.heading")}</h2>
                <p>{t("about.overview.body1")}</p>
                <p>{t("about.overview.body2")}</p>
            </div>
            <div class="about-image">
                <img src="/placeholder.svg" alt="Our team at work" loading="lazy" />
            </div>
        </div>
    </section>

    <section class="mission-section">
        <div class="container mission-grid">
            <div>
                <h3>{t("about.vision.heading")}</h3>
                <p>{t("about.vision.body")}</p>
            </div>
            <div>
                <h3>{t("about.objective.heading")}</h3>
                <p>{t("about.objective.body")}</p>
            </div>
        </div>
    </section>

    <section>
        <div class="container leadership-container leadership-grid">
            <div>
                <h2>{t("about.leadership.heading")}</h2>
                <p>{t("about.leadership.body1")}</p>
                <p>{t("about.leadership.body2")}</p>
            </div>
        </div>
    </section>

    <section>
        <div class="container mission-grid">
            <div>
                <h3>{t("about.whyChooseUs.heading")}</h3>
                <p>{t("about.whyChooseUs.body")}</p>
            </div>
            <div>
                <h3>{t("about.safety.heading")}</h3>
                <p>{t("about.safety.body")}</p>
            </div>
        </div>
    </section>
</Layout>

<style>
    .about-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 48px;
        align-items: center;
    }

    .about-image img {
        border-radius: 4px;
    }

    .mission-section {
        background: var(--color-bg-alt);
    }

    .leadership-container {
        /*max-width: 780px;*/
    }

    .leadership-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: center;
    }

    .ceo-bio {
        margin-top: 1.5rem;
        padding: 20px 24px;
        background: var(--color-bg-alt);
        border-left: 3px solid var(--color-red);
        border-radius: 4px;
    }

    .cert-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 0.5rem;
        color: var(--color-red);
        font-weight: 600;
        text-decoration: none;
    }

    .cert-link:hover {
        text-decoration: underline;
    }

    .cert-embed {
        display: block;
        width: 100%;
        max-width: 600px;
        height: 700px;
        margin-top: 1rem;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    .iso-grid {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .iso-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 16px 24px;
        background: var(--color-bg-alt);
        border-radius: 4px;
        min-width: 160px;
    }

    .iso-item span {
        font-size: 0.85rem;
        color: #666;
    }

    .tools-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 24px;
        margin-top: 24px;
    }

    .tool-card {
        text-align: center;
    }

    .tool-card img {
        max-height: 60px;
        width: auto;
        margin: 0 auto 10px;
    }

    .tool-card p {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-navy);
    }

    @media (max-width: 800px) {
        .tools-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 500px) {
        .tools-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .mission-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }

    @media (max-width: 800px) {
        .about-grid,
        .mission-grid {
            grid-template-columns: 1fr;
        }

        .about-image {
            order: -1;
        }
    }
</style>
