---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ItemCard from '../../../components/ItemCard.astro';
import { getServices, matches } from '../../../lib/content';
import { badLang } from '../../../lib/lang';
import { getLangFromUrl, useTranslations, localizePath } from '../../../i18n/ui';

if (badLang(Astro.params.lang)) return new Response(null, { status: 404 });
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const q = Astro.url.searchParams.get('q') ?? '';
const services = getServices().filter((s) => matches(s, q));
---

<Layout title={t('services.title')}>
	<PageHeader title={t('services.title')} subtitle={t('services.subtitle')} />
	<section>
		<div class="container">
			<form class="filters" method="get">
				<input type="search" name="q" value={q} placeholder={t('services.search')} aria-label={t('common.search')} />
				<button class="btn" type="submit">{t('common.search')}</button>
			</form>
			{services.length === 0 && <p>{t('services.noResults')}</p>}
			<div class="grid">
				{
					services.map((s) => (
						<ItemCard href={localizePath(`/services/${s.slug}`, lang)} title={s.name} text={s.summary} image={s.image} />
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.filters {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 32px;
	}
	.filters input {
		flex: 1 1 240px;
		font: inherit;
		padding: 10px 12px;
		border: 1px solid #ddd;
		border-radius: 4px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 24px;
	}
</style>
