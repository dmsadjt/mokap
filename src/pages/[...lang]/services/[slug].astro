---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getServices } from '../../../lib/content';
import { badLang } from '../../../lib/lang';
import { getLangFromUrl, useTranslations, localizePath } from '../../../i18n/ui';

if (badLang(Astro.params.lang)) return new Response(null, { status: 404 });
const service = getServices().find((s) => s.slug === Astro.params.slug);
if (!service) return new Response(null, { status: 404 });
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={service.name} description={service.summary}>
	<PageHeader title={service.name} subtitle={service.summary} />
	<section>
		<div class="container detail">
			{service.image && <img src={service.image} alt={service.name} />}
			<div>
				{service.body && <p>{service.body}</p>}
				{
					service.bullets?.length > 0 && (
						<>
							<h3>{t('services.whatsIncluded')}</h3>
							<ul>{service.bullets.map((b) => <li>{b}</li>)}</ul>
						</>
					)
				}
				<a class="btn" href={localizePath('/contact', lang)}>{t('common.contactUs')}</a>
				<p><a class="back" href={localizePath('/services', lang)}>{t('common.back')}</a></p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.detail {
		max-width: 860px;
	}
	.detail img {
		width: 100%;
		border-radius: 4px;
		margin-bottom: 24px;
	}
	.back {
		color: var(--color-red);
		font-weight: 700;
		text-decoration: none;
	}
</style>
