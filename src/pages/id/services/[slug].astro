---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getServices } from '../../../lib/content';
import { getLangFromUrl, useTranslations, localizePath } from '../../../i18n/ui';
import Icon from '../../../components/Icon.astro';


const service = getServices().find((x) => x.slug === Astro.params.slug);
if (!service) return new Response(null, { status: 404 });
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={service.name}>
	<PageHeader title={service.name} subtitle={service.summary} />

	<section>
		<div class="container">
			{service.body && <p class="description">{service.body}</p>}

			{
				service.bullets && (
					<ul class="bullets-list">
						{service.bullets.map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				)
			}

			{
				service.brochures && (
					<ul class="brochure-list">
						{service.brochures.map((brochure) => (
							<li>
								<a href={brochure.href} target="_blank" rel="noopener">
									<Icon name="description" size={18} />
									{brochure.label}
								</a>
							</li>
						))}
					</ul>
				)
			}

			<a class="btn" href={localizePath('/contact', lang)}>
				{t('common.contactUs')}
			</a>
		</div>
	</section>

	{
		service.caseStudies && (
			<section class="case-studies">
				<div class="container">
					<span class="label">{t('services.caseStudies.heading')}</span>
					<div class="case-grid">
						{service.caseStudies.map((cs) => (
							<div class="case-card">
								{cs.image && <img class="case-image" src={cs.image} alt={cs.title} loading="lazy" />}
								<h3>{cs.title}</h3>
								{cs.customer && (
									<p class="case-customer">
										{t('services.customer')}: {cs.customer}
									</p>
								)}

								{cs.summary && (
									<>
										<h4>{t('services.summary')}</h4>
										<p>{cs.summary}</p>
									</>
								)}

								{cs.challenge && (
									<>
										<h4>{t('services.challenge')}</h4>
										<p>{cs.challenge}</p>
									</>
								)}

								{cs.specs && (
									<>
										<h4>{t('services.specSummary')}</h4>
										<ul>
											{cs.specs.map((spec) => (
												<li>{spec}</li>
											))}
										</ul>
									</>
								)}

								{cs.solutions && (
									<>
										<h4>{t('services.solutions')}</h4>
										<ul>
											{cs.solutions.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</>
								)}

								{cs.scope && (
									<>
										<h4>{t('services.whatWeDid')}</h4>
										<ul>
											{cs.scope.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</>
								)}

								{cs.result && (
									<>
										<h4>{t('services.result')}</h4>
										<ul>
											{cs.result.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</>
								)}
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}
</Layout>

<style>
	section .container {
		max-width: 860px;
	}

	.description {
		font-size: 1.05rem;
		margin-bottom: 1.5rem;
	}

	.bullets-list {
		margin: 0 0 2rem;
		padding-left: 20px;
		display: grid;
		gap: 10px;
	}

	.brochure-list {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
		display: grid;
		gap: 10px;
	}

	.brochure-list a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--color-red);
		font-weight: 600;
		text-decoration: none;
	}

	.brochure-list a:hover {
		text-decoration: underline;
	}

	.case-studies {
		background: var(--color-bg-alt);
	}

	.case-grid {
		display: grid;
		gap: 20px;
	}

	.case-card {
		background: #fff;
		border-radius: 4px;
		padding: 24px;
		overflow: hidden;
	}

	.case-image {
		width: calc(100% + 48px);
		margin: -24px -24px 16px;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.case-card h3 {
		color: var(--color-navy);
		font-size: 1.1rem;
		margin-bottom: 4px;
	}

	.case-customer {
		margin: 0 0 1rem;
		font-size: 0.9rem;
		color: #666;
		font-style: italic;
	}

	.case-card h4 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--color-navy);
		margin: 1rem 0 0.5rem;
	}

	.case-card p {
		margin: 0;
		font-size: 0.95rem;
	}

	.case-card ul {
		margin: 0;
		padding-left: 20px;
		font-size: 0.9rem;
		display: grid;
		gap: 6px;
	}
</style>
