---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getSolutions } from '../../../lib/content';
import { getLangFromUrl, useTranslations, localizePath } from '../../../i18n/ui';


const solution = getSolutions().find((x) => x.slug === Astro.params.slug);
if (!solution) return new Response(null, { status: 404 });
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={solution.name}>
	<PageHeader title={solution.name} subtitle={solution.summary} />

	<section>
		<div class="container">
			<p class="description">{solution.description}</p>

			{
				solution.products && (
					<ul class="products-list">
						{solution.products.map((product) => (
							<li>{product}</li>
						))}
					</ul>
				)
			}

			<a class="btn" href={localizePath('/contact', lang)}>
				{t('common.contactUs')}
			</a>
		</div>
	</section>

	{
		solution.caseStudies && (
			<section class="case-studies">
				<div class="container">
					<span class="label">{t('solutions.caseStudies.heading')}</span>
					<div class="case-grid">
						{solution.caseStudies.map((cs) => (
							<div class="case-card">
								{cs.image && <img class="case-image" src={cs.image} alt={cs.title} loading="lazy" />}
								{cs.category && <span class="case-category">{cs.category}</span>}
								<h3>{cs.title}</h3>
								{cs.customer && <p class="case-customer">{cs.customer}</p>}

								{cs.specs && (
									<>
										<h4>{t('solutions.specSummary')}</h4>
										<ul>
											{cs.specs.map((spec) => (
												<li>{spec}</li>
											))}
										</ul>
									</>
								)}

								{cs.materialSpec && (
									<>
										<h4>{t('solutions.materialSpec')}</h4>
										<ul>
											{cs.materialSpec.map((spec) => (
												<li>{spec}</li>
											))}
										</ul>
									</>
								)}

								{cs.codeCompliance && (
									<>
										<h4>{t('solutions.codeCompliance')}</h4>
										<ul>
											{cs.codeCompliance.map((code) => (
												<li>{code}</li>
											))}
										</ul>
									</>
								)}

								{cs.scope && (
									<>
										<h4>{t('solutions.whatWeDid')}</h4>
										<ul>
											{cs.scope.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</>
								)}
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}
</Layout>

<style>
	section .container {
		max-width: 860px;
	}

	.description {
		font-size: 1.05rem;
		margin-bottom: 1.5rem;
	}

	.products-list {
		margin: 0 0 2rem;
		padding-left: 20px;
		display: grid;
		gap: 10px;
	}

	.case-studies {
		background: var(--color-bg-alt);
	}

	.case-grid {
		display: grid;
		gap: 20px;
	}

	.case-card {
		background: #fff;
		border-radius: 4px;
		padding: 24px;
		overflow: hidden;
	}

	.case-image {
		width: calc(100% + 48px);
		margin: -24px -24px 16px;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.case-category {
		display: inline-block;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--color-red);
		margin-bottom: 6px;
	}

	.case-card h3 {
		color: var(--color-navy);
		font-size: 1.1rem;
		margin-bottom: 4px;
	}

	.case-customer {
		margin: 0 0 1rem;
		font-size: 0.9rem;
		color: #666;
		font-style: italic;
	}

	.case-card h4 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--color-navy);
		margin: 1rem 0 0.5rem;
	}

	.case-card ul {
		margin: 0;
		padding-left: 20px;
		font-size: 0.9rem;
		display: grid;
		gap: 6px;
	}
</style>
