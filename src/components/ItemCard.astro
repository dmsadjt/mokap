---
interface Props {
	href: string;
	title: string;
	text?: string;
	image?: string;
	meta?: string;
	badge?: string;
}

const { href, title, text, image, meta, badge } = Astro.props;
---

<a class="item-card" href={href}>
	<div class="thumb">
		{image ? <img src={image} alt={title} loading="lazy" /> : <img src="/placeholder.svg" alt="" loading="lazy" />}
	</div>
	<div class="body">
		{badge && <span class="badge">{badge}</span>}
		<h3>{title}</h3>
		{meta && <small>{meta}</small>}
		{text && <p>{text}</p>}
	</div>
</a>

<style>
	.item-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		border: 1px solid #e5e5e5;
		border-radius: 4px;
		overflow: hidden;
		background: #fff;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.item-card:hover {
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
		transform: translateY(-2px);
	}
	.thumb {
		aspect-ratio: 16 / 10;
		background: var(--color-bg-alt);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.body {
		padding: 18px 20px 22px;
	}
	.body h3 {
		margin: 0 0 6px;
		font-size: 1.1rem;
		color: var(--color-navy);
	}
	.body p {
		margin: 8px 0 0;
		font-size: 0.95rem;
	}
	small {
		color: #777;
	}
	.badge {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-red);
		margin-bottom: 6px;
	}
</style>
