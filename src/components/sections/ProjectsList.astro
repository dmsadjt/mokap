---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="projects-list">
	<div class="container">
		<div class="projects-intro">
			<div>
				<span class="label">{t('projectsList.label')}</span>
				<h2>{t('projectsList.heading')}</h2>
				<p>{t('projectsList.body')}</p>
			</div>
			<a href={localizePath('/projects', lang)} class="btn">{t('projectsList.cta')}</a>
		</div>
	</div>
</section>

<style>
	.projects-intro {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 32px;
		flex-wrap: wrap;
		margin-bottom: 40px;
	}

	.projects-intro > div {
		max-width: 700px;
	}
</style>
