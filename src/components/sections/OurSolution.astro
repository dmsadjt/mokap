---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="our-solution">
	<div class="container">
		<span class="label">{t('ourSolution.label')}</span>
		<h2>{t('ourSolution.heading')}</h2>
		<p>{t('ourSolution.body')}</p>
	</div>
</section>

<style>
	.our-solution {
		background: var(--color-bg-alt);
	}

	.our-solution .container {
		max-width: 860px;
	}

	.our-solution h2 {
		font-size: 1.9rem;
	}
</style>
