---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slides = [
	{ heading: t('hero.slide1'), href: '/about' },
	{ heading: t('hero.slide2'), href: '/about' },
	{ heading: t('hero.slide3'), href: '/services/flame-scanner' },
];
---

<section class="hero">
	<div class="hero-overlay"></div>
	<div class="container hero-content">
		{
			slides.map((slide, i) => (
				<div class:list={['hero-slide', { 'is-active': i === 0 }]} data-slide={i} aria-hidden={i !== 0}>
					<h1>{slide.heading}</h1>
					<a href={localizePath(slide.href, lang)} class="btn">
						{t('common.readMore')}
					</a>
				</div>
			))
		}
		<div class="hero-dots">
			{slides.map((_, i) => <span class:list={['hero-dot', { 'is-active': i === 0 }]} data-dot={i} aria-hidden="true" />)}
		</div>
	</div>
</section>

<script>
	const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
	const dots = document.querySelectorAll<HTMLElement>('.hero-dot');
	let active = 0;

	function show(index: number) {
		slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
		dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
		active = index;
	}

	show(0);
	setInterval(() => show((active + 1) % slides.length), 5000);
</script>

<style>
	.hero {
		position: relative;
		min-height: 560px;
		display: flex;
		align-items: center;
		background: linear-gradient(135deg, var(--color-navy), #3a5a9c);
		padding: 0;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(26, 39, 68, 0.85) 0%, rgba(26, 39, 68, 0.45) 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 640px;
	}

	.hero-slide {
		display: none;
	}

	.hero-slide.is-active {
		display: block;
	}

	.hero-slide h1 {
		color: #fff;
		font-size: 2.75rem;
		font-weight: 800;
		margin-bottom: 1.5rem;
	}

	.hero-dots {
		display: flex;
		gap: 10px;
		margin-top: 2rem;
	}

	.hero-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.4);
		cursor: default;
	}

	.hero-dot.is-active {
		background: var(--color-red);
	}

	@media (max-width: 700px) {
		.hero-slide h1 {
			font-size: 2rem;
		}
	}
</style>
