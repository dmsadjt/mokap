---
import { getServices } from '../../lib/content';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const services = getServices();
---

<section class="our-services">
	<div class="container services-grid">
		<div>
			<span class="label">{t('home.services.label')}</span>
			<h2>{t('home.services.heading')}</h2>
			<p>{t('home.services.body')}</p>
			<a href={localizePath('/services', lang)} class="btn">{t('common.readMore')}</a>
		</div>
		<ul class="services-list">
			{
				services.map((s) => (
					<li>
						<span class="bullet" aria-hidden="true" />
						<a href={localizePath(`/services/${s.slug}`, lang)}>{s.name}</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.our-services {
		background: var(--color-navy);
		color: #fff;
	}
	.our-services .label {
		color: #ff5757;
	}
	.services-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: center;
	}
	.services-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 18px;
	}
	.services-list li {
		display: flex;
		align-items: center;
		gap: 14px;
		font-weight: 600;
	}
	.services-list a {
		text-decoration: none;
	}
	.services-list a:hover {
		text-decoration: underline;
	}
	.bullet {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-red);
		flex-shrink: 0;
	}
	@media (max-width: 800px) {
		.services-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
