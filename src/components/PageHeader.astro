---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="page-header">
	<div class="container">
		<h1>{title}</h1>
		{subtitle && <p>{subtitle}</p>}
	</div>
</section>

<style>
	.page-header {
		background: var(--color-navy);
		color: #fff;
		padding: 56px 0;
	}

	.page-header h1 {
		font-size: 2.2rem;
		margin-bottom: 0.25rem;
	}

	.page-header p {
		opacity: 0.85;
		margin: 0;
		max-width: 640px;
	}
</style>
